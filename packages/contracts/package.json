{
  "name": "@sentinel/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts derived from /specs: generated TypeScript types, MSW fixtures, and contract validation.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fixtures": "./src/fixtures/events.ts"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../specs/openapi.yaml -o ./src/generated/api-schema.d.ts",
    "generate:events": "json2ts -i ../../specs/events-schema.json -o ./src/generated/events.d.ts",
    "validate": "node --experimental-strip-types ./src/validate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "json-schema-to-typescript": "^15.0.4",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
