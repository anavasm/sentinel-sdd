{
  "name": "@sentinel/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API for DevSecOps Sentinel AI: audit lifecycle, RFC 9457 errors, SSE event stream (specs/openapi.yaml).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@sentinel/contracts": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.9"
  }
}
